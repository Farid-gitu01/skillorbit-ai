# ==============================================================================
# SkillOrbit AI — Git Ignore Configuration (Repository Root)
# ==============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
*/node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.npm/

# ── Environment & Secrets ─────────────────────────────────────────────────────
# Ignore all .env files and environment variants
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
*.env.local

# Specific known credential files
atlas-credentials.env
credentials.txt
creadentials.txt
*credential*.txt
*credentials*.txt
*secret*.txt

# Private keys, certificates, and tokens
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
id_rsa
id_rsa.pub

# Whitelist environment templates and documentation
!.env.example
!*.env.example
!**/.env.example

# ── Build & Generated Output ─────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.next/
.turbo/
.parcel-cache/
.cache/
*.tsbuildinfo

# Vite cache
.vite/
*/.vite/

# ── Testing & Coverage ────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Logs & Runtime Data ───────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Temporary & Cache Files ───────────────────────────────────────────────────
*.tmp
*.temp
.temp/
.tmp/

# ── IDE & Editor Directories ──────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ── Operating System Files ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Database Dumps & Local Backups ────────────────────────────────────────────
*.dump
*.sql
*.sqlite
*.sqlite3
*.rdb
*.bak
