# ==============================================================================
# SkillOrbit AI — Frontend .gitignore
# ==============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
*.local

# Whitelist safe template
!.env.example

# ── Build & Generated Output ─────────────────────────────────────────────────
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# ── Testing & Coverage ────────────────────────────────────────────────────────
coverage/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── IDE & Editor Directories ──────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ── Operating System ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
