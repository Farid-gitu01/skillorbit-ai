# SkillOrbit AI – Backend Environment Variables
# Copy this file to .env and fill in the values.
# Never commit the .env file.

# ── Server ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────
# URL of the frontend (Vite dev server or deployed origin)
CLIENT_URL=http://localhost:5173

# ── Email delivery (optional in development; required in production) ─────────
# SMTP credentials are backend-only. Production requires all values below.
SMTP_HOST=
SMTP_PORT=
# true for implicit TLS (commonly port 465); false for STARTTLS (commonly 587)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ── Database ──────────────────────────────────────────────────────────
# MongoDB Atlas connection string — REQUIRED
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# ── Authentication ────────────────────────────────────────────────────
# JWT signing secret — REQUIRED — use a long random string (≥ 32 characters)
JWT_SECRET=
# Token lifetime — e.g. 7d, 24h, 3600 (seconds)
JWT_EXPIRES_IN=7d

# ── AI Integration (optional until Phase 3) ───────────────────────────
# Name of the AI provider: openai | azure-openai | anthropic | custom
AI_PROVIDER=
# API key for the AI provider — keep on the backend only; never expose to the frontend
AI_API_KEY=
