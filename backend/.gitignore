# ==============================================================================
# SkillOrbit AI — Backend .gitignore
# ==============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
*.pem
*.key
*.p12
*.pfx
*credential*.txt
*secret*.txt

# Whitelist safe template
!.env.example

# ── Build & Generated Output ─────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Testing & Coverage ────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDE & Editor ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
*~

# ── Operating System ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
